generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DEACTIVATE
  BANNED
  DELETED
}

model user {
  id              String      @id @default(uuid())
  handle          String      @unique
  displayName     String
  email           String      @unique
  password        String?
  
  role            Role        @default(USER)
  status          UserStatus  @default(ACTIVE)

  regIp           String
  lastIp          String
  countryCode     String
  isEmailVerified Boolean     @default(false)
  
  bio             String?     @db.VarChar(200)
  avatarUrl       String?
  locale          String
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  thirdparty      thirdparty[]
  session         session[]
}

model thirdparty {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user               user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  userAgent    String?
  ipAddress    String?
  lastActive   DateTime @default(now())

  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model system_settings {
  id                    String    @id
  isReadOnlyMode        Boolean
  isRegistrationClosed  Boolean
}

enum CloudItemKind {
  FILE
  FOLDER
}

enum CloudShareRole {
  VIEWER
  EDITOR
}

model cloud_share {
  id          String         @id @default(uuid())
  itemId      String
  item        cloud_item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId      String
  // Null means personal preference only, never an access grant.
  role        CloudShareRole? @default(VIEWER)
  starred     Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([itemId, userId])
  @@index([userId, itemId])
}

// Only UUIDs and storage accounting are kept locally, never auth profiles.
model cloud_storage {
  userId      String   @id
  usedBytes   BigInt   @default(0)
  limitBytes  BigInt   @default(10737418240)
  updatedAt   DateTime @updatedAt
}

enum CloudLinkAccess {
  RESTRICTED
  PUBLIC
}

model cloud_link {
  itemId    String          @id
  item      cloud_item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  token     String          @unique
  access    CloudLinkAccess @default(RESTRICTED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// ownerId controls tree access; storageOwnerId identifies the original uploader.
model cloud_item {
  id          String        @id @default(uuid())
  ownerId     String
  storageOwnerId String?
  kind        CloudItemKind
  name        String        @db.VarChar(255)
  parentId    String?
  parent      cloud_item?   @relation("CloudTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    cloud_item[]  @relation("CloudTree")
  shares      cloud_share[]
  link        cloud_link?
  mimeType    String?
  size        BigInt        @default(0)
  storageKey  String?       @unique
  starred     Boolean       @default(false)
  deletedAt   DateTime?
  trashBatchId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ownerId, parentId, deletedAt])
  @@index([ownerId, kind, deletedAt])
  @@index([storageOwnerId, kind])
}
